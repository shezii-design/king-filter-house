# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CLOUD AUTHENTICATION & DATABASE KEYS
# Add your Supabase URL and Anon/Public Key below for GitHub repository setup or deployment.
# In Vite applications, these environment variables are exposed to the client build.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here


